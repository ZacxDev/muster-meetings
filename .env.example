# Copy to .env and fill in. Placeholders only: never commit a real token.

# Where the plugin calls muster: https://, or http:// to localhost / 127.0.0.1 / [::1] only.
MUSTER_URL=https://muster.example.test

# The plugin token(s) (mpl_…), each shown once when you create the plugin on
# muster's /plugins page with "App tab" checked. One per owner the plugin
# serves, comma-separated; one is the common case. Each acts as its owner on
# muster's /plugin/v1/* routes only.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# muster's origin as your browser sees it: the only page allowed to frame the
# Meetings app (CSP frame-ancestors). No path.
MUSTER_ORIGIN=https://muster.example.test

# This plugin's own origin: a subdomain of muster's host, never muster's own
# origin. The same value goes into muster's MUSTER_PLUGIN_ORIGINS, and the
# token's entry URL is <this>/enter. Guest links are built on it.
MEETINGS_PUBLIC_URL=https://meet.muster.example.test

# The public listener (behind your HTTPS proxy) and the internal one (/healthz).
MEETINGS_LISTEN=:8080
MEETINGS_INTERNAL_LISTEN=:8081

# Where the SQLite database (meetings.db) lives. Keep it across restarts.
STATE_DIR=./state
