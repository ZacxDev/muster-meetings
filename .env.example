# Copy to .env and fill in. Placeholders only: never commit a real token.

# Where the plugin calls muster: https://, or http:// only to localhost /
# 127.0.0.1 / [::1], to a FULLY-QUALIFIED Service name with its trailing dot
# (http://muster.<namespace>.svc.cluster.local.:8105 in Kubernetes), or to
# exactly the host MEETINGS_MUSTER_HTTP_HOST names (muster, in Compose).
MUSTER_URL=https://muster.example.test

# Exactly ONE server-installed app's token (mpl_…), shown once when an admin
# installs Meetings on muster's /admin/apps (or by `muster-server app
# install`). It serves every person on the muster; a comma refuses to start.
# It acts for nobody until a person opens the tab, and only on muster's
# /plugin/v1/* routes.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# muster's origin as your browser sees it: the only page allowed to frame the
# Meetings app (CSP frame-ancestors). No path.
MUSTER_ORIGIN=https://muster.example.test

# This plugin's own origin: a subdomain of muster's host, never muster's own
# origin. The same value goes into muster's MUSTER_PLUGIN_ORIGINS, and the
# app's entry URL is <this>/enter. Guest links are built on it.
MEETINGS_PUBLIC_URL=https://meet.muster.example.test

# 32 random bytes, base64: every meeting's link code is derived from it, so its
# owner can copy an open meeting's link again. Changing it changes every open
# meeting's link. Generate with `openssl rand -base64 32` and keep it in the
# plugin's own Secret. Required.
MEETINGS_LINK_KEY=replace_with_openssl_rand_base64_32

# The cluster's DNS domain for the rule above (default cluster.local), and
# the one host plain http may go to (exact match; empty: none).
#MEETINGS_CLUSTER_DOMAIN=cluster.local
#MEETINGS_MUSTER_HTTP_HOST=muster

# The public listener (behind your HTTPS proxy) and the internal one (/healthz).
MEETINGS_LISTEN=:8080
MEETINGS_INTERNAL_LISTEN=:8081

# Where the SQLite database (meetings.db) lives. Keep it across restarts.
STATE_DIR=./state

# LiveKit (phase 2b). Where browsers connect for the call: wss:// (ws:// only
# to a loopback host). The pages may connect to this origin and nowhere else.
MEETINGS_LIVEKIT_URL=wss://meet-rtc.muster.example.test
# LiveKit's server API as the plugin reaches it (in the cluster; http is fine).
MEETINGS_LIVEKIT_API_URL=http://livekit:7880
# LiveKit's API key and secret. The secret signs every token and verifies
# LiveKit's webhook (point it at http://<plugin>:8081/livekit/webhook). It
# never reaches a browser.
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_with_a_long_random_secret
# relay (default): media only through TURN over TLS, the deployment's one
# media path. all: a local LiveKit with no TURN.
#MEETINGS_LIVEKIT_ICE=relay
# The ingress in front of the plugin, for the per-address knock limit.
#MEETINGS_TRUSTED_PROXIES=10.0.0.0/8
# A header holding ONE client address (e.g. CF-Connecting-IP behind
# Cloudflare), believed in place of X-Forwarded-For, and only when the request
# comes from MEETINGS_TRUSTED_PROXIES (refuses to start without them).
#MEETINGS_CLIENT_IP_HEADER=CF-Connecting-IP

# The transcript. off (the default), utterance: each pause-cut utterance goes
# to the STT service muster's dictation uses (stt-cohere), with its bearer (a
# COPY of stt-cohere's STT_API_TOKEN); or nemotron: live captions from
# muster's stt-nemotron server, falling back per participant to utterance, so
# it needs ALL FOUR of the URLs and tokens below or it refuses to start. fake
# is for tests only (MEETINGS_TEST_MODE=1).
#MEETINGS_STT_ENGINE=utterance
#MEETINGS_STT_URL=http://stt-cohere:8000
#MEETINGS_STT_TOKEN=replace_me
#MEETINGS_STREAM_STT_URL=ws://stt-nemotron:8000/v1/stream
#MEETINGS_STREAM_STT_TOKEN=replace_me
# With an engine: the ingest URL tokens' key (openssl rand -base64 32), the
# ingest listener (Egress's alone: never route it), and where Egress reaches it.
#MEETINGS_INGEST_SECRET=replace_with_openssl_rand_base64_32
#MEETINGS_INGEST_LISTEN=:8082
#MEETINGS_INGEST_URL=ws://muster-meetings:8082
